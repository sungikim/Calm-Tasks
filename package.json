{
  "name": "obsidian-calm-tasks",
  "version": "0.2.0",
  "private": true,
  "description": "A calm Obsidian task workspace with optional Microsoft To Do sync.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.mjs production",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "tasks",
    "calendar",
    "markdown"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  }
}
